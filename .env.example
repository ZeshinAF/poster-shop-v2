# Backend base URL (poster-shop-backend). Leave empty for demo mode: bundled
# catalog snapshot, checkout sends nothing.
# Local dev against the backend (note 127.0.0.1, not localhost — the backend
# binds IPv4 and Node resolves localhost to ::1 first):
#   VITE_API_URL=http://127.0.0.1:8787
# Production builds require https:// (the build fails otherwise).
VITE_API_URL=
